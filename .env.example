# weeing-weeing 환경변수 전체 목록. 로컬: cp .env.example .env / 서버: 9절 참고
# 내 .env 점검(값·키는 출력하지 않음): make env-check
# 규칙: 절 순서·변수 순서를 바꾸지 않는다. 설명은 변수 위 한 줄. 새 항목은 config.py와 같이 추가한다.
# 표시: [로컬] 로컬에서만 의미 / [서버] 운영 서버에서만 의미 / 표시 없음 = 둘 다

# ── 1. 비밀 키 ── 주석을 풀고 값을 넣는다. 커밋·로그 금지
# Claude. 빈 값(ANTHROPIC_API_KEY=)은 `ant auth login` 프로필보다 우선해 인증이 실패한다
ANTHROPIC_API_KEY=
# Voyage 임베딩·리랭크. 키를 받은 곳에 맞춰 3절 VOYAGE_BASE_URL도 바꾼다
VOYAGE_API_KEY=
# Langfuse 사용량 기록. 김민우에게 개인별로 받는다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── 2. LLM (Claude) ──
# 모델 ID. 가장 싼 것: claude-haiku-5-5 / 팀 기본: claude-sonnet-5-5
LLM_MODEL=claude-sonnet-5-5
# 생각 깊이 low|medium|high|xhigh|max. 높을수록 느리고 비싸다
LLM_EFFORT=medium
# 호출 전체 시간 예산(초). 429·5xx·연결 오류는 이 안에서 최대 2번 재시도
LLM_TIMEOUT_S=120
# 사건 하나 분석에서 LLM 호출 상한(도구 루프 폭주 방지)
AGENT_MAX_TURNS=8
# true면 Error 사건마다 Claude 자동 호출(비용). 시연할 때만 켠다
ANALYSIS_AUTO_ENABLED=false
# single: 기존 분석 / multi: 문서·정비이력 조사 후 통합 분석(LangGraph)
ANALYSIS_MODE=multi
# multi에서만 적용. false는 검증 생략, true는 독립 검증 및 최대 1회 수정
ANALYSIS_VERIFICATION_ENABLED=true
# 멀티 분석 전체의 시간(초)·Claude 호출 상한(각 역할의 AGENT_MAX_TURNS와 별도)
ANALYSIS_TOTAL_TIMEOUT_S=300
ANALYSIS_MAX_CALLS=24
# true면 분석 없이 센서·사건만 DB에 저장. ANALYSIS_AUTO_ENABLED=true면 무관하게 저장
TELEMETRY_DB_ENABLED=false
# 로컬 호환 기본 false. 운영 compose는 true로 강제하며 해시가 없으면 송신 거부
TELEMETRY_AUTH_REQUIRED=false
# 센서 송신 전용 토큰의 SHA-256(hex). 원본 토큰을 저장소에 쓰지 않는다
TELEMETRY_PRODUCER_TOKEN_SHA256=
# 로컬 SIM_RPM 시험만 허용. 운영 인증/자동 분석 모드 및 외부 접속에서는 거부
TELEMETRY_SIMULATION_RPM_ENABLED=false
# 새 Unreal 상태·이벤트 프레임은 backend 먼저 배포한 뒤 명시적으로 켠다
TELEMETRY_UNREAL_CONTEXT_ENABLED=false

# ── 3. 임베딩·리랭크 (docs/EMBEDDING_API.md) ──
# hashing(외부 호출 0) | voyage(Voyage API, 본문이 외부로 나감)
EMBEDDING_PROVIDER=hashing
# 비우면 공급자 기본값(hashing-kiwi-v1 / voyage-4-lite)
EMBEDDING_MODEL=
# 벡터 차원. voyage는 256·512·1024·2048
EMBEDDING_DIM=1024
# Voyage 대시보드 키(pa-…): 그대로 / MongoDB Atlas 키: https://ai.mongodb.com/v1 (틀리면 HTTP 403)
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_TIMEOUT_S=30
# Voyage 리랭크 모델(가장 싼 것: rerank-3-lite). 비우면 리랭크 끔(비용 0)
RERANKER_MODEL=
# 리랭크할 검색 후보 수. 리랭커를 쓸 때만 의미 있다
RAG_CANDIDATE_K=30
# 리랭커 관련도 하한. 비우면 끔. RERANKER_MODEL 없이 지정하면 설정 오류
RAG_MIN_RELEVANCE=

# ── 4. 벡터 저장소 ──
# qdrant | chroma
VECTOR_STORE=qdrant
# 컬렉션 이름. 3절 공급자·모델·차원을 바꾸면 새 이름으로 바꾸고 문서를 다시 등록한다
RAG_COLLECTION=knowledge_voyage
# [로컬] Qdrant 로컬 모드 폴더(한 프로세스만 열 수 있음)
QDRANT_PATH=storage/qdrant
# 비우면 로컬 모드. 서버 모드: http://localhost:6333 ([서버]는 compose가 덮어씀)
QDRANT_URL=
QDRANT_TIMEOUT_S=10
# [로컬] VECTOR_STORE=chroma일 때 폴더
CHROMA_DIR=storage/chroma
# 웹 업로드 원본 폴더(git 밖)
UPLOAD_DIR=storage/uploads

# ── 5. DB ──
# docker compose의 postgres 계정. [서버]는 비밀번호를 새로 만든다(처음 띄운 뒤엔 바꿔도 적용 안 됨)
POSTGRES_USER=weeing
POSTGRES_PASSWORD=weeing
POSTGRES_DB=weeing
# [로컬] Docker 없이: sqlite:///storage/dev.db ([서버]는 compose가 덮어씀)
DATABASE_URL=postgresql://weeing:weeing@localhost:5432/weeing
# 연결·잠금 대기(초). 넘으면 문서 API는 503
DB_TIMEOUT_S=5

# ── 6. 로그인 ──
# 로그인 세션 유효 시간(시간)
AUTH_SESSION_HOURS=12

# ── 7. LLM 사용량 기록 (Langfuse, docs/USAGE_TRACKING.md) ──
# 사람별 집계 이름. 본인 GitHub 핸들
LLM_USER=
# https://langfuse.<HOME_DOMAIN>. 비우면 기록 끔
LANGFUSE_BASE_URL=
# dev | demo | ci
LANGFUSE_TRACING_ENVIRONMENT=dev
# false면 본문 없이 토큰·모델·시간만 보낸다
LANGFUSE_CAPTURE_CONTENT=true

# ── 8. 데이터 재생 ──
TELEMETRY_CSV=data/telemetry/battery_tray_transfer_telemetry_v3_15cols.csv
# 1.0 = 실시간(1초에 1행), 10 = 10배속
REPLAY_SPEED=1.0
# WebSocket 입력의 실행별 사건 이력 폴더
TELEMETRY_HISTORY_DIR=outputs/incident_history

# ── 9. [서버] 운영 서버 전용 (deploy/docker-compose.prod.yml, docs/DEPLOY.md) ──
# 서버 .env를 처음 만들 때만 이 파일 전체를 붙여 넣고 1·5·9절을 채운다. 이미 있는 서버 .env를 덮어쓰지 않는다
# (POSTGRES_PASSWORD가 weeing으로 돌아가면 DB 인증 실패로 로그인이 503이 된다). 빠진 줄만 make env-check로 찾아 넣는다
# 서버 IP나 도메인을 넣으면 HTTPS. 비우면 :80(HTTP)
# SITE_ADDRESS=
# Langfuse 대시보드 주소(deploy/langfuse). 비우면 끈다
# LANGFUSE_ADDRESS=
# 배포 워크플로가 적는다. 직접 쓰지 않는다
# IMAGE_TAG=
# API만 배포할 때 사용하는 별도 태그. 전체 배포에서는 IMAGE_TAG와 같게 갱신
# API_IMAGE_TAG=
# Caddy만 배포할 때 사용하는 별도 태그. 전체 배포에서는 IMAGE_TAG와 같게 갱신
# WEB_IMAGE_TAG=
# IMAGE_PREFIX=
# PYTHONUTF8·PYTHONIOENCODING·PYTHONPATH는 Makefile이 자동 설정한다(여기에 적지 않는다)

# 미래 Error ML 관찰 모드. 모델 SHA-256이 일치해야 로드하며 Detector·제어에는 연결하지 않는다.
ML_PREDICTION_ENABLED=false
ML_MODEL_PATH=models/future_error.joblib
ML_MODEL_SHA256=
ML_PREDICTION_DIR=outputs/ml_live
