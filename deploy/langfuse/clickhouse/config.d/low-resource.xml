<!--
  2코어·8GB EC2에서 Langfuse용 ClickHouse를 가볍게 돌리는 서버 설정(docs/DEPLOY.md "EC2 자체 Langfuse").
  기본값 그대로면 ClickHouse가 자기 진단 로그(system.*_log)를 계속 쓰고 합치느라 CPU 2코어를 거의 다 쓰고,
  보관 기한이 없어 3일에 약 3GB씩 디스크가 늘었다(2026-11-09 확인). Langfuse는 이 테이블들을 읽지 않는다.
  - 진단 로그 테이블을 끈다. 조사용으로 query_log(3일)와 error_log(에러 종류별 집계, 작음)만 남긴다.
  - 메모리 할당마다 trace_log에 기록하는 서버 메모리 프로파일러를 끈다.
  - 파일 로그는 warning 이상만, 100MB × 3개까지 둔다.
  - 같은 서버의 앱(api·frontend·postgres 등)과 메모리를 나누도록 RAM의 30%까지만 쓴다.
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <size>100M</size>
        <count>3</count>
    </logger>

    <max_server_memory_usage_to_ram_ratio>0.3</max_server_memory_usage_to_ram_ratio>
    <total_memory_profiler_step>0</total_memory_profiler_step>
    <!-- background_pool_size는 기본값(16)을 둔다. 줄이면 MergeTree 설정 검사(mutation용 빈 슬롯 20개)에
         걸려 서버가 시작하지 않는다. 진단 로그를 끄면 병합할 것이 거의 없어 기본값으로도 CPU를 쓰지 않는다. -->

    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <latency_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <blob_storage_log remove="1"/>

    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 3 DAY</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
</clickhouse>
