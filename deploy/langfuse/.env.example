# 서버 ~/langfuse/.env 예시(docs/DEPLOY.md). 비밀 값은 서버에서 만들고 레포에 적지 않는다.
# 비밀번호는 URL에 들어가므로 영문·숫자만 쓴다(openssl rand -hex 16).
NEXTAUTH_URL=https://langfuse.<EC2_IP>.sslip.io
NEXTAUTH_SECRET=
SALT=
# openssl rand -hex 32 (64자)
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
# 다른 Langfuse에서 데이터를 옮겨 올 때는 SALT·ENCRYPTION_KEY를 원래 서버 값 그대로 쓴다.
# SALT가 다르면 기존 API 키(sk) 인증이 실패하고, ENCRYPTION_KEY가 다르면 저장된 LLM 연결 키를 못 읽는다.

# ── 빈 서버에 새로 설치할 때만 ──
# 처음 시작할 때 조직·프로젝트·API 키·관리자 계정을 만든다. 옮겨 온 데이터가 있으면 모두 비워 둔다.
# 같은 키를 앱 .env의 LANGFUSE_PUBLIC_KEY·LANGFUSE_SECRET_KEY에 넣는다
# LANGFUSE_INIT_ORG_ID=weeing-weeing
# LANGFUSE_INIT_ORG_NAME=weeing-weeing
# LANGFUSE_INIT_PROJECT_ID=weeing-weeing-ec2
# LANGFUSE_INIT_PROJECT_NAME=weeing-weeing-ec2
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=admin
# LANGFUSE_INIT_USER_PASSWORD=
