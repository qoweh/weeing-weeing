# 서버 입구. 경로 규칙은 docs/DEPLOY.md 참고.
# SITE_ADDRESS가 비어 있으면 :80(IP로 HTTP). IP나 도메인을 넣으면 Caddy가 HTTPS 인증서를 자동으로 받고
# http 접속을 https로 넘긴다.
{
	admin off
	# IP로 접속하면 브라우저가 SNI(접속 이름)를 보내지 않는다. 그때 SITE_ADDRESS의 인증서를 쓴다.
	default_sni {$SITE_ADDRESS:localhost}
	# Let's Encrypt는 IP 주소에 shortlived 프로필(약 6일, 자동 갱신)로만 인증서를 준다. 도메인에도 그대로 쓴다.
	cert_issuer acme {
		profile shortlived
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# CCTV 영상은 외부 시청자가 같은 HTTPS 출처에서 받는다.
	handle /cctv-viewer {
		root * /srv
		rewrite * /cctv-viewer.html
		file_server
	}
	redir /cctv /cctv/
	handle /cctv/* {
		reverse_proxy weeing-cctv-udp-test:8889
	}

	# FastAPI: /api 접두사를 떼고 넘긴다(hmi/web의 vite 개발 프록시와 같은 규칙). WebSocket도 그대로 통과한다.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# hmi/web(Vite) 정적 빌드
	redir /hmi /hmi/
	handle_path /hmi/* {
		root * /srv/hmi
		try_files {path} /index.html
		file_server
	}

	# 나머지는 frontend(Next.js)
	handle {
		reverse_proxy frontend:3100
	}
}

# Unreal의 인증서 이름 검증은 DNS 이름을 사용한다. 기존 IP 웹 주소는 유지한다.
telemetry.<EC2_IP>.sslip.io {
	handle_path /api/* {
		reverse_proxy api:8000
	}
	respond 404
}

# Langfuse 대시보드(deploy/langfuse). 공식 이미지는 하위 경로를 지원하지 않아 이름으로 나눈다.
# LANGFUSE_ADDRESS가 비어 있으면 서버 밖에서 닿지 않는 이름으로 두어 꺼 둔다.
{$LANGFUSE_ADDRESS:http://langfuse.localhost} {
	encode zstd gzip
	reverse_proxy langfuse-web:3000
}
